# Create this file locally with .\scripts\setup-neon.ps1.
# Never commit .env or share it in a public repository.
DATABASE_URL=jdbc:postgresql://YOUR_NEON_POOLER_HOST/neondb?sslmode=require
DATABASE_USERNAME=YOUR_NEON_ROLE
DATABASE_PASSWORD=replace-with-your-neon-password

# Optional integrations and local admin credentials.
SHAZAM_RAPIDAPI_KEY=
SHAZAM_RAPIDAPI_HOST=shazam.p.rapidapi.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password123
