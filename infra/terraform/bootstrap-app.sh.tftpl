#!/usr/bin/env bash
set -euxo pipefail
export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y awscli curl docker.io docker-compose-v2 jq python3 snapd
systemctl enable --now docker
snap install amazon-ssm-agent --classic || true
systemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service || true

install -d -m 0700 /etc/melodex /opt/melodex /run/melodex
printf '%s' '${deploy_script_b64}' | base64 --decode > /usr/local/bin/melodex-deploy
chmod 0755 /usr/local/bin/melodex-deploy
printf '%s' '${compose_file_b64}' | base64 --decode > /opt/melodex/compose.aws.yaml
printf '%s' '${nginx_config_b64}' | base64 --decode > /opt/melodex/nginx.conf
install -d -m 0755 /opt/aws/amazon-cloudwatch-agent/etc
printf '%s' '${cloudwatch_config_b64}' | base64 --decode > /opt/aws/amazon-cloudwatch-agent/etc/melodex.json

cat > /etc/melodex/deploy.env <<'EOF'
AWS_REGION=${aws_region}
ECR_REGISTRY=${ecr_registry}
DB_SECRET_ARN=${db_secret_arn}
ADMIN_SECRET_ARN=${admin_secret_arn}
RAPIDAPI_SECRET_ARN=${rapidapi_secret_arn}
DEPLOY_ENVIRONMENT=${environment}
NEON_PROJECT_ID=${neon_project_id}
SHAZAM_RAPIDAPI_HOST=${rapidapi_host}
EOF
chmod 0600 /etc/melodex/deploy.env

cloudwatch_deb=/tmp/amazon-cloudwatch-agent.deb
curl -fsSL https://amazoncloudwatch-agent.s3.amazonaws.com/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb \
  -o "$cloudwatch_deb"
dpkg -i "$cloudwatch_deb"
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -c file:/opt/aws/amazon-cloudwatch-agent/etc/melodex.json -s
